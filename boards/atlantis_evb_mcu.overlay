// Tenstorrent Atlantis EVB MCU

#include "atlantis_common.dtsi"

/*
 * Host power rails (doc/hardware.rst, "SoC rails controlled by the
 * MCU"): the ATX supply, then the SLT order, the M.2 slot and the
 * handshakes. The schematic gives no inter-rail timings; the settle
 * times cover the regulators' own soft-start and are placeholders until
 * the SoC power sequencing specification gives real numbers.
 */
/ {
	power_rails: power-rails {
		/*
		 * ATX T1 + T3: up to 1 s from PS_ON to PWR_OK. On power off the
		 * PSU stays on while the LPDDR5 PMIC shuts down.
		 */
		atx: atx {
			compatible = "wallabmc,power-rail";
			enable = <&atx_pson>;
			power-good = <&atx_pwr_ok>;
			power-good-timeout-ms = <2000>;
			off-delay-ms = <100>;
		};
		/*
		 * PG_PH1 and PG_PH2 are clamped to about 2 V by LEDs; if PC7
		 * reads low with VCORE up, move pg_ph1 to power-good-optional
		 * (see Known issues). The TPS546E25 secondary's PG_PH2 is
		 * undocumented in a stack, so it only warns until measured.
		 */
		vcore_0v8: vcore_0v8 {
			compatible = "wallabmc,power-rail";
			enable = <&vcore_0v8_en>;
			power-good = <&pg_ph1>;
			power-good-optional = <&pg_ph2>;
		};
		mpm54304: mpm54304 {
			compatible = "wallabmc,power-rail";
			enable = <&mpm54304_en>;
			power-good = <&mpm54304_gpio>;
		};
		ddr_vdd: ddr_vdd {
			compatible = "wallabmc,power-rail";
			enable = <&ddr_vdd_en>;
			power-good = <&pwr_good_lpddr5>;
		};
		ddr_vdd2l: ddr_vdd2l {
			compatible = "wallabmc,power-rail";
			enable = <&ddr_vdd2l_en>;
			power-good = <&pwr_good_0v9>;
		};
		ddr_vddq: ddr_vddq {
			compatible = "wallabmc,power-rail";
			enable = <&ddr_vddq_en>;
			settle-ms = <1>;
		};
		pcie_vp: pcie_vp {
			compatible = "wallabmc,power-rail";
			enable = <&pcie_vp_en>;
			settle-ms = <5>;
		};
		pcie_vph: pcie_vph {
			compatible = "wallabmc,power-rail";
			enable = <&pcie_vph_en>;
			settle-ms = <5>;
		};
		/* TPS25200 turn-on plus the PCIe T_PVPERL before reset release */
		m2: m2 {
			compatible = "wallabmc,power-rail";
			enable = <&m2_vcc_en>;
			settle-ms = <120>;
		};
		/* Handshakes to the SoC, driven once every rail is up */
		pwr1_gd: pwr1_gd {
			compatible = "wallabmc,power-rail";
			enable = <&pwr1_gd_out>;
		};
		pwr2_gd: pwr2_gd {
			compatible = "wallabmc,power-rail";
			enable = <&pwr2_gd_out>;
		};
		otp_pwrrdy: otp_pwrrdy {
			compatible = "wallabmc,power-rail";
			enable = <&otp_pwrrdy_out>;
		};
	};

	power_sequencer: power-sequencer {
		compatible = "wallabmc,power-sequencer";
		power-on-sequence = <&atx &vcore_0v8 &mpm54304 &ddr_vdd &ddr_vdd2l
				     &ddr_vddq &pcie_vp &pcie_vph &m2
				     &pwr1_gd &pwr2_gd &otp_pwrrdy>;
		power-off-sequence = <&otp_pwrrdy &pwr2_gd &pwr1_gd
				      &m2 &pcie_vph &pcie_vp &ddr_vddq
				      &ddr_vdd2l &ddr_vdd &mpm54304 &vcore_0v8 &atx>;
		/* SoC junction over-temperature: power off at once */
		fault = <&tj_max>;
	};
};

/*
 * The EVB has no DIP switches on the mux selects and the pull-ups leave
 * them at 11 (no source), so route both SoC JTAG ports to the USB bridge
 * U73 until jtag.c takes a port for the MCU. The M.2 enable has no pull
 * resistor; the hog keeps the slot off from MCUboot until the power
 * sequence reaches it.
 */
&gpioa {
	sys_jtag0_sel0_hog: sys_jtag0_sel0_hog {
		gpio-hog;
		gpios = <5 GPIO_ACTIVE_HIGH>;
		output-low;
	};
	sys_jtag0_sel1_hog: sys_jtag0_sel1_hog {
		gpio-hog;
		gpios = <6 GPIO_ACTIVE_HIGH>;
		output-low;
	};
	sys_jtag1_sel0_hog: sys_jtag1_sel0_hog {
		gpio-hog;
		gpios = <11 GPIO_ACTIVE_HIGH>;
		output-low;
	};
	sys_jtag1_sel1_hog: sys_jtag1_sel1_hog {
		gpio-hog;
		gpios = <12 GPIO_ACTIVE_HIGH>;
		output-low;
	};
};

&gpioc {
	m2_vcc_en_hog: m2_vcc_en_hog {
		gpio-hog;
		gpios = <13 GPIO_ACTIVE_HIGH>;
		output-low;
	};
};
